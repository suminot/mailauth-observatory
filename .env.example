# 認証情報のテンプレート。.env にコピーして値を入れる（.env は Git に入れない）
#
# 引き継ぎのため、各キーの取得元をここに明記しておくこと。
# DESIGN.md 1.4「個人アカウント資産への依存」への対策。

# EDINET API v2 Subscription-Key（無料・要登録）
# 取得: https://api.edinet-fsa.go.jp/api/auth/index.aspx?mode=1
MAILAUTH_EDINET_SUBSCRIPTION_KEY=

# gBizINFO API トークン（無料・申請制）
# 取得: https://info.gbiz.go.jp/api/index.html
# 未設定でも P1 は動く（official_url が欠損し、manifest に記録される）
MAILAUTH_GBIZINFO_TOKEN=

# 国税庁 法人番号 Web-API アプリケーションID（無料）
# 取得: https://www.houjin-bangou.nta.go.jp/webapi/
# 未設定でも P1 は動く（商号・所在地の裏取りがスキップされる）
MAILAUTH_HOUJIN_BANGOU_APP_ID=

# SEC EDGAR は API キー不要だが User-Agent の申告が必須（無しは 403）
# 「氏名 メールアドレス」形式。Sprint 1.5 で使用
MAILAUTH_SEC_USER_AGENT=
