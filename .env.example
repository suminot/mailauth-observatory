# 認証情報のテンプレート。.env にコピーして値を入れる（.env は Git に入れない）
#
# 引き継ぎのため、各キーの取得元をここに明記しておくこと。
# DESIGN.md 1.4「個人アカウント資産への依存」への対策。

# EDINET API v2 Subscription-Key（無料・要登録）
# 取得: https://api.edinet-fsa.go.jp/api/auth/index.aspx?mode=1
MAILAUTH_EDINET_SUBSCRIPTION_KEY=

# gBizINFO API トークン（無料・申請制）
# 取得: https://info.gbiz.go.jp/api/index.html
# 未設定でも P1 は動く（official_url が欠損し、manifest に記録される）
MAILAUTH_GBIZINFO_TOKEN=

# 国税庁 法人番号 Web-API アプリケーションID（無料）
# 取得: https://www.houjin-bangou.nta.go.jp/webapi/
# 未設定でも P1 は動く（商号・所在地の裏取りがスキップされる）
MAILAUTH_HOUJIN_BANGOU_APP_ID=

# 連絡先メールアドレス。SEC EDGAR は User-Agent に連絡先を含めることを
# 必須としており、偽の値を送るのは規約違反である。
# **未設定だと us-all-listed は理由を添えて止まる**（黙って偽装しない）。
# Wikidata Query Service も連絡先つきの User-Agent を作法としている。
MAILAUTH_CONTACT_EMAIL=

# GLEIF API はキー不要。LEI の照会に使う（レート制御のみ）

# ---------------------------------------------------------------------------
# bronze / silver の退避先（DESIGN.md 第9章「持続性」）
#
# **2か所に送る。** bronze を失うと過去の再解釈ができなくなり、原則1
# （生データは不変）の意味がなくなる。1か所しか設定していない場合、
# `mailauth offload` は送信に成功しても「持続性の基準は満たしていない」と
# 言う（黙って基準未達で運用させない）。
#
# **同じ事業者に2つ置いても持続性は上がらない。** 副は別事業者・別アカウント
# にすること。R2 のアカウントを失う事故と同時に失われる場所は退避先にならない。
# ---------------------------------------------------------------------------

# 主: Cloudflare R2（S3 互換）
# 取得: Cloudflare ダッシュボード → R2 → Manage R2 API Tokens
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 副: R2 以外の S3 互換保管先（Backblaze B2 / Wasabi / AWS S3 など）
# 取得: 各事業者のコンソールでアクセスキーを発行する
BACKUP_ENDPOINT=
BACKUP_BUCKET=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
